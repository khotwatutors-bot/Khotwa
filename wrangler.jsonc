{
  "name": "khotwa",
"main": "./worker.js",
"keep_vars": true, 
"compatibility_date": "2026-11-14",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "khotwa_production",
      "database_id": "7c696d6d-1200-42c4-96fb-0ebd6cba7c5e"
    }
  ]
}
